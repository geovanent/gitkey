#!/bin/bash
#
# gitkey — CLI wrapper
#

POSSIBLE_PATHS=(
    "$HOME/.ssh/gitkey/lib/switch_profile.py"
    "$HOME/.ssh/gitkey/switch_profile.py"
    "$HOME/.ssh/switch_profile.py"
    "$HOME/.ssh/switch_profile_git/switch_profile.py"
)

SCRIPT_PATH=""

for path in "${POSSIBLE_PATHS[@]}"; do
    if [ -f "$path" ]; then
        SCRIPT_PATH="$path"
        break
    fi
done

if [ -z "$SCRIPT_PATH" ]; then
    WRAPPER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$WRAPPER_DIR/lib/switch_profile.py" ]; then
        SCRIPT_PATH="$WRAPPER_DIR/lib/switch_profile.py"
    elif [ -f "$WRAPPER_DIR/switch_profile.py" ]; then
        SCRIPT_PATH="$WRAPPER_DIR/switch_profile.py"
    fi
fi

if [ -z "$SCRIPT_PATH" ] || [ ! -f "$SCRIPT_PATH" ]; then
    echo "Error: gitkey is not installed. Run: curl -fsSL https://raw.githubusercontent.com/geovanent/gitkey/main/install.sh | bash" >&2
    exit 1
fi

if command -v python3 &>/dev/null; then
    exec python3 "$SCRIPT_PATH" "$@"
elif command -v python &>/dev/null; then
    exec python "$SCRIPT_PATH" "$@"
fi

echo "Error: Python 3 is required." >&2
exit 1
